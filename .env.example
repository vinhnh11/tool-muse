# Batch Video Studio - cấu hình máy chủ (chép thành .env rồi sửa)
# KHÔNG commit file .env. API key của provider video / LLM nhập trên giao diện
# (Cài đặt, Provider) - được mã hóa trong DB, không nằm ở đây.

# Cổng HTTP (web + API cùng một cổng)
PORT=7878
HOST=127.0.0.1

# Thư mục dữ liệu (SQLite) và lưu video/asset bền vững
DATA_DIR=./data
STORAGE_DIR=./storage

# Khóa chủ để mã hóa secret trong DB (32 byte, base64). Bỏ trống: tự sinh
# file data/master.key lần chạy đầu. Mất khóa này = mất các API key đã lưu.
APP_MASTER_KEY=

# inline: server tự chạy scheduler | off: chỉ API (chạy worker riêng bằng npm run worker)
WORKER_MODE=inline

# Đường dẫn ffmpeg/ffprobe (bỏ trống = lấy trên PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# Thư mục nhận video khi bấm "Đưa sang chỉnh sửa" (tùy chọn, vd thư mục imports của app dựng video)
EDIT_INBOX_DIR=

# URL công khai của server - chỉ cần khi dùng webhook của provider (polling không cần)
PUBLIC_BASE_URL=
